# Copia este archivo a .env y cambia la clave por una contraseña larga y única.
ADMIN_PASSWORD=pon-aqui-una-clave-larga-y-unica
PORT=3000
HOST=0.0.0.0
# En hosting, asigna DATA_FILE a un disco persistente.
# DATA_FILE=/ruta/persistente/tonusco.json

# Google Wallet: crea y autoriza una cuenta de servicio en Google Wallet Console.
# No pegues estas credenciales en GitHub ni en el chat; configúralas como secretos en Render.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=

# Apple Wallet: Pass Type ID, certificado .p12 y certificado intermedio WWDR.
# Los dos valores *_BASE64 deben contener los archivos codificados en Base64.
# APPLE_PASS_TYPE_IDENTIFIER=
# APPLE_TEAM_IDENTIFIER=
# APPLE_PASS_CERT_P12_BASE64=
# APPLE_PASS_CERT_PASSWORD=
# APPLE_WWDR_CERT_BASE64=
